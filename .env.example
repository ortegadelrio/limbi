# Copia a .env.local y rellena con tus valores (no commitees .env.local).
# Las claves públicas de Supabase son seguras en el cliente; el anon key sigue sujeto a RLS.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# En Supabase: Site URL y Redirect URLs (ver README).

# Solo servidor (Route Handlers, Server Actions). Nunca NEXT_PUBLIC_.
OPENAI_API_KEY=
# Modelo para POST /api/projects/:id/generate-master (Responses API). Si está vacío, se usa el fallback en código (ver lib/openai/master-document.ts).
OPENAI_MASTER_DOCUMENT_MODEL=
# Modelo para POST /api/projects/:id/generate-framework (Responses API). Si está vacío, fallback en lib/openai/visible-framework.ts.
OPENAI_VISIBLE_FRAMEWORK_MODEL=
# Modelo para POST /api/projects/:id/generate-content (Responses API). Si está vacío, fallback en lib/openai/content-generation.ts.
OPENAI_CONTENT_GENERATION_MODEL=
